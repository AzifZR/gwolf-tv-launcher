<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:paddingBottom="@dimen/spacing_sm">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md"
        android:textAppearance="@style/TextAppearance.OhryuTV.H2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Nama Aplikasi" />

    <!-- dialog-header-violet separator -->
    <View
        android:id="@+id/dialog_header_rule"
        android:layout_width="0dp"
        android:layout_height="@dimen/dialog_rule_height"
        android:background="@color/colorAccentViolet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_title" />

    <Button
        android:id="@+id/btn_pin"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="@dimen/target_min"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@drawable/bg_menu_item"
        android:gravity="center_vertical|start"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:text="@string/action_pin"
        android:textAllCaps="false"
        android:textColor="@color/bg_menu_item_text"
        android:textSize="@dimen/font_body_lg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_header_rule" />

    <Button
        android:id="@+id/btn_hide"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="@dimen/target_min"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@drawable/bg_menu_item"
        android:gravity="center_vertical|start"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:text="@string/action_hide"
        android:textAllCaps="false"
        android:textColor="@color/bg_menu_item_text"
        android:textSize="@dimen/font_body_lg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_pin" />

    <Button
        android:id="@+id/btn_app_info"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="@dimen/target_min"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@drawable/bg_menu_item"
        android:gravity="center_vertical|start"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:text="@string/action_app_info"
        android:textAllCaps="false"
        android:textColor="@color/bg_menu_item_text"
        android:textSize="@dimen/font_body_lg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_hide" />

    <Button
        android:id="@+id/btn_uninstall"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="@dimen/target_min"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@drawable/bg_menu_item"
        android:gravity="center_vertical|start"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:text="@string/action_uninstall"
        android:textAllCaps="false"
        android:textColor="@color/bg_menu_item_text"
        android:textSize="@dimen/font_body_lg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_app_info" />

</androidx.constraintlayout.widget.ConstraintLayout>
