<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow stroke ring (6dp lime ~35% alpha) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="@dimen/glow_soft"
                android:color="@color/colorFocusGlow" />
        </shape>
    </item>
    <!-- Inner focused card -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorSurfaceHover" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="@dimen/border_focus"
                android:color="@color/colorPrimaryLime" />
        </shape>
    </item>
</layer-list>
